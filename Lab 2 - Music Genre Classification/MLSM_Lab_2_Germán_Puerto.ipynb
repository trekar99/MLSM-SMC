      "cell_type": "markdown",
      "source": [
        "### CNN Homemade Model (Audios 1D)"
      ],
      "metadata": {
        "id": "WqrH1o9qpwuy"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "class RawAudioCNN(nn.Module):\n",
        "    def __init__(self, num_classes):\n",
        "        super(RawAudioCNN, self).__init__()\n",
        "\n",
        "        # The kernel_size in 1D represents the analyzed time \"window\".\n",
        "        # Large initial kernel to capture low-frequency patterns (pitch).\n",
        "\n",
        "        # --- Block 1 ---\n",
        "        # Conv1d(in_channels, out_channels, kernel_size, stride, padding)\n",
        "        self.conv1 = nn.Conv1d(1, 32, kernel_size=64, stride=4, padding=32)\n",
        "        self.bn1 = nn.BatchNorm1d(32)\n",
        "        self.pool1 = nn.MaxPool1d(kernel_size=4) # Reduction of the sequence length\n",
        "\n",
        "        # --- Block 2 ---\n",
        "        self.conv2 = nn.Conv1d(32, 64, kernel_size=32, stride=2, padding=16)\n",
        "        self.bn2 = nn.BatchNorm1d(64)\n",
        "        self.pool2 = nn.MaxPool1d(kernel_size=4)\n",
        "\n",
        "        # --- Block 3 (Smaller filters for fine details) ---\n",
        "        self.conv3 = nn.Conv1d(64, 128, kernel_size=16, stride=2, padding=8)\n",
        "        self.bn3 = nn.BatchNorm1d(128)\n",
        "\n",
        "        # Classification Layer\n",
        "        self.dropout = nn.Dropout(p=0.5)\n",
        "\n",
        "        # Global Average Pooling 1D (GAP) to flatten the remaining temporal sequence\n",
        "        # This eliminates the need to calculate the size of the FC layer input.\n",
        "        # The input to FC is simply the number of final channels (128).\n",
        "        self.fc1 = nn.Linear(128, 64)\n",
        "        self.fc2 = nn.Linear(64, num_classes)\n",
        "\n",
        "    def forward(self, x):\n",
        "        # x shape: (Batch Size, 1, Samples)\n",
        "\n",
        "        # Block 1\n",
        "        x = self.pool1(F.relu(self.bn1(self.conv1(x))))\n",
        "        # Block 2\n",
        "        x = self.pool2(F.relu(self.bn2(self.conv2(x))))\n",
        "        # Block 3\n",
        "        x = F.relu(self.bn3(self.conv3(x)))\n",
        "\n",
        "        # Global Average Pooling (Reduces from [B, 128, Length] to [B, 128, 1])\n",
        "        # This averages the features along the time axis.\n",
        "        x = F.adaptive_avg_pool1d(x, 1)\n",
        "\n",
        "        # Flatten to [Batch, 128]\n",
        "        x = x.squeeze(-1)\n",
        "\n",
        "        x = self.dropout(x)\n",
        "\n",
        "        # FC Layers\n",
        "        x = F.relu(self.fc1(x))\n",
        "        x = self.fc2(x)\n",
        "\n",
        "        return x"
      ],
      "metadata": {
        "id": "GvjMLJfOyTwc"
      },
