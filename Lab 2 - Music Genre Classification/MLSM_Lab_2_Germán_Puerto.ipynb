      "source": [
        "class AudioFolderDataset(Dataset):\n",
        "    def __init__(self, data_dir, sample_rate=16000, duration=30):\n",
        "\n",
        "        self.data_dir = data_dir\n",
        "        self.sample_rate = sample_rate\n",
        "        self.duration = duration\n",
        "\n",
        "        # 1. Obtener los nombres de las clases (carpetas)\n",
        "        self.classes = sorted([d.name for d in os.scandir(data_dir) if d.is_dir()])\n",
        "        self.class_to_idx = {cls_name: i for i, cls_name in enumerate(self.classes)}\n",
        "\n",
        "        # 2. Mapear todos los archivos de audio a sus etiquetas\n",
        "        self.samples = []\n",
        "        for class_name in self.classes:\n",
        "            class_path = os.path.join(data_dir, class_name)\n",
        "            target_idx = self.class_to_idx[class_name]\n",
        "\n",
        "            # Buscar todos los archivos .wav en esa carpeta\n",
        "            for file_name in os.listdir(class_path):\n",
        "                if file_name.endswith('.wav'):\n",
        "                    file_path = os.path.join(class_path, file_name)\n",
        "                    self.samples.append((file_path, target_idx))\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.samples)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        # Obtener el path del archivo y la etiqueta numérica\n",
        "        audio_path, label = self.samples[idx]\n",
        "\n",
        "        # --- Carga y Preprocesamiento de Audio ---\n",
        "        try:\n",
        "            # Cargar el audio usando librosa. Mono por defecto (dtype=float32)\n",
        "            # El parámetro 'sr' remuestrea el audio a la tasa deseada (ej. 48000 Hz)\n",
        "            audio, sr = librosa.load(audio_path, sr=self.sample_rate)\n",
        "\n",
        "            # Asegurar la misma duración (recorte o padding)\n",
        "            num_samples = int(self.duration * self.sample_rate)\n",
        "            if len(audio) > num_samples:\n",
        "                # Recorte: Tomar una sección si es más larga (puedes randomizar esto para Data Augmentation)\n",
        "                audio = audio[:num_samples]\n",
        "            elif len(audio) < num_samples:\n",
        "                # Padding: Rellenar con ceros si es más corta\n",
        "                padding = num_samples - len(audio)\n",
        "                audio = np.pad(audio, (0, padding), 'constant')\n",
        "\n",
        "            # Convertir a tensor\n",
        "            audio_tensor = torch.tensor(audio, dtype=torch.float32)\n",
        "\n",
        "            # El codificador de CLAP espera la forma [Canales, Muestras], así que añadimos el canal\n",
        "            # Si el audio es mono, es [1, Muestras]. Si fuera estéreo sería [2, Muestras].\n",
        "            audio_tensor = audio_tensor.unsqueeze(0)\n",
        "\n",
        "        except Exception as e:\n",
        "            # En caso de error de carga, retorna un placeholder o salta\n",
        "            #print(f\"Error cargando {audio_path}: {e}\")\n",
        "            return None, None # Se debe manejar en el DataLoader\n",
        "\n",
        "        return audio_tensor, torch.tensor(label, dtype=torch.long)"
      ],
      "metadata": {
        "id": "6wETYQt5tD1S"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def custom_collate_fn(batch):\n",
        "    \"\"\"\n",
        "    Filtra las muestras que son None (archivos corruptos) y luego apila el batch.\n",
        "    \"\"\"\n",
        "    # 1. Filtrar las entradas nulas.\n",
        "    batch = list(filter(lambda x: x[0] is not None, batch))\n",
        "\n",
        "    if not batch:\n",
        "        # Si todo el batch son audios corruptos, devuelve None o un tensor vacío.\n",
        "        # Devuelve un tensor de ceros para evitar errores en el loop de entrenamiento.\n",
        "        # Nota: El loop de entrenamiento debe manejar un batch vacío.\n",
        "        # Es mejor devolver None y manejar la excepción en el loop principal.\n",
        "        return None\n",
        "\n",
        "    # 2. Separar audios y etiquetas\n",
        "    audios = [item[0] for item in batch]\n",
        "    labels = [item[1] for item in batch]\n",
        "\n",
        "    # 3. Apilar audios y etiquetas en tensores\n",
        "    # Nota: Dado que hicimos padding en __getitem__, la forma es consistente\n",
        "    audios = torch.stack(audios)\n",
        "    labels = torch.stack(labels)\n",
        "\n",
        "    return audios, labels"
      ],
      "metadata": {
        "id": "ZmLMuiYQwDFs"
      },
      "execution_count": null,
      "outputs": []
