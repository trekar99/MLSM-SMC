      "cell_type": "markdown",
      "source": [
        "### Fine-tuning EfficientNet B0 Model"
      ],
      "metadata": {
        "id": "pVsJWX6s6ibQ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "class EfficientNetGenreClassifier(nn.Module):\n",
        "    def __init__(self, num_classes, freeze_features=True):\n",
        "        \"\"\"\n",
        "        Initializes EfficientNetB0 for fine-tuning on 1-channel spectrograms.\n",
        "        \"\"\"\n",
        "        super().__init__()\n",
        "\n",
        "        # 1. Load the pre-trained EfficientNetB0 model from torchvision\n",
        "        weights = models.EfficientNet_B0_Weights.DEFAULT\n",
        "        self.efficientnet = models.efficientnet_b0(weights=weights)\n",
        "\n",
        "        # 2. Freeze the base feature layers (Recommended for small datasets)\n",
        "        if freeze_features:\n",
        "            for param in self.efficientnet.parameters():\n",
        "                param.requires_grad = False\n",
        "\n",
        "        # 3. CRUCIAL MODIFICATION: Change the input layer to accept 1 channel (Grayscale)\n",
        "        # The feature extractor starts at index 0, and the first layer is also index 0.\n",
        "        original_conv = self.efficientnet.features[0][0] # Accesses the _conv_stem layer\n",
        "\n",
        "        # Create a new Conv2d layer with in_channels=1\n",
        "        self.efficientnet.features[0][0] = nn.Conv2d(\n",
        "            in_channels=1,\n",
        "            out_channels=original_conv.out_channels,\n",
        "            kernel_size=original_conv.kernel_size,\n",
        "            stride=original_conv.stride,\n",
        "            padding=original_conv.padding,\n",
        "            bias=original_conv.bias\n",
        "        )\n",
        "\n",
        "        # 4. REPLACE THE FINAL CLASSIFICATION HEAD\n",
        "        # The number of input features for the classifier is 1280 in EfficientNetB0\n",
        "        num_ftrs = self.efficientnet.classifier[1].in_features\n",
        "\n",
        "        self.efficientnet.classifier = nn.Sequential(\n",
        "            nn.Dropout(p=0.2, inplace=True),\n",
        "            nn.Linear(num_ftrs, num_classes) # New classification layer\n",
        "        )\n",
        "\n",
        "        # Note: Unfreeze the new layers\n",
        "        self.efficientnet.features[0][0].requires_grad_(True) # Unfreeze the new input layer\n",
        "        self.efficientnet.classifier.requires_grad_(True)     # Unfreeze the new classification head\n",
        "\n",
        "    def forward(self, x):\n",
        "        # x shape should be: [Batch Size, 1, H, W]\n",
        "        return self.efficientnet(x)"
      ],
      "metadata": {
        "id": "-7T90EmR6hTs"
