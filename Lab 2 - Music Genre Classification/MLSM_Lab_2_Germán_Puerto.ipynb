      "cell_type": "code",
      "source": [
        "def walk_through_dir(dir_path):\n",
        "  \"\"\"\n",
        "  Walks through dir_path returning its contents.\n",
        "  Args:\n",
        "    dir_path (str or pathlib.Path): target directory\n",
        "\n",
        "  Returns:\n",
        "    A print out of:\n",
        "      number of subdiretories in dir_path\n",
        "      number of images (files) in each subdirectory\n",
        "      name of each subdirectory\n",
        "  \"\"\"\n",
        "  for dirpath, dirnames, filenames in os.walk(dir_path):\n",
        "    print(f\"There are {len(dirnames)} directories and {len(filenames)} images in '{dirpath}'.\")"
      ],
      "metadata": {
        "id": "TzC3VO9ANL1C"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def split_dataset(input_dir: str, output_dir: str, test_size: float = 0.2, random_seed: int = 42, file_extension: str = '.png'):\n",
        "    \"\"\"\n",
        "    Splits into a dataset structured by class folders\n",
        "    (e.g., input_dir/typeX/image.jpg) into 'train' and 'test' sets.\n",
        "\n",
        "    Args:\n",
        "        input_dir (str): The root directory where class folders are located (e.g., 'images').\n",
        "        output_dir (str): The destination directory where 'train' and 'test' folders will be created (e.g., 'datasets').\n",
        "        test_size (float): Proportion of images for the test set (e.g., 0.2 for 20%).\n",
        "        random_seed (int): Seed for randomization, ensures reproducibility.\n",
        "        file_extension (str): File extension of images to process (e.g., '.jpg').\n",
        "\n",
        "    Returns:\n",
        "        None: The function operates by copying files to the output_dir.\n",
        "    \"\"\"\n",
        "\n",
        "    print(f\"Starting data split from '{input_dir}'...\")\n",
        "    print(f\"Parameters: Train={100 - test_size*100:.0f}%, Test={test_size*100:.0f}%\")\n",
        "\n",
        "    # 1. Prepare the output structure\n",
        "    train_output = os.path.join(output_dir, 'train')\n",
        "    test_output = os.path.join(output_dir, 'test')\n",
        "\n",
        "    os.makedirs(train_output, exist_ok=True)\n",
        "    os.makedirs(test_output, exist_ok=True)\n",
        "\n",
        "    # 2. Iterate through classes (subdirectories)\n",
        "    try:\n",
        "        classes = sorted([d for d in os.listdir(input_dir)\n",
        "                         if os.path.isdir(os.path.join(input_dir, d))])\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Error: Input directory '{input_dir}' was not found.\")\n",
        "        return\n",
        "\n",
        "    if not classes:\n",
        "        print(f\"Warning: No class subdirectories found in '{input_dir}'.\")\n",
        "        return\n",
        "\n",
        "    total_images_processed = 0\n",
        "\n",
        "    for clase in classes:\n",
        "        clase_path = os.path.join(input_dir, clase)\n",
        "\n",
        "        # 2.1 List files with the specified extension\n",
        "        archivos = [f for f in os.listdir(clase_path) if f.lower().endswith(file_extension)]\n",
        "\n",
        "        if not archivos:\n",
        "            print(f\"   -> Class '{clase}' skipped: No {file_extension} files found.\")\n",
        "            continue\n",
        "\n",
        "        # 3. Stratified Splitting (Train/Test)\n",
        "        # Randomly splits the files list for the current class\n",
        "        archivos_train, archivos_test = train_test_split(\n",
        "            archivos,\n",
        "            test_size=test_size,\n",
        "            random_state=random_seed\n",
        "        )\n",
        "\n",
        "        # 4. Copying Files\n",
        "        for conjunto, lista_archivos, destino_root in [\n",
        "            ('train', archivos_train, train_output),\n",
        "            ('test', archivos_test, test_output)\n",
        "        ]:\n",
        "            # Create the class subdirectory in the destination\n",
        "            destino_clase_path = os.path.join(destino_root, clase)\n",
        "            os.makedirs(destino_clase_path, exist_ok=True)\n",
        "\n",
        "            # Copy files\n",
        "            for nombre_archivo in lista_archivos:\n",
        "                origen = os.path.join(clase_path, nombre_archivo)\n",
        "                destino = os.path.join(destino_clase_path, nombre_archivo)\n",
        "                shutil.copy2(origen, destino) # copy2 preserves metadata\n",
        "\n",
        "        total_images_processed += len(archivos)\n",
        "        print(f\"   -> Class '{clase}': Total={len(archivos)} | Train={len(archivos_train)} | Test={len(archivos_test)}\")\n",
        "\n",
        "    print(f\"\\n✅ Split and copy complete! Total images processed: {total_images_processed}.\")"
      ],
      "metadata": {
        "id": "UftlbTbGP60_"
      },
      "execution_count": null,
      "outputs": []
    },
