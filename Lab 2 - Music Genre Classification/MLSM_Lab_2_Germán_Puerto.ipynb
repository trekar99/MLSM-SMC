        "def predict_genre(model, class_names, sr=16000, duration=30, device=device):\n",
        "    \"\"\"\n",
        "    Prompts the user to upload an audio file in Colab, processes it, and predicts the genre.\n",
        "\n",
        "    Args:\n",
        "        model (nn.Module): The trained RawAudioCNN model.\n",
        "        class_names (list): List of genre names (e.g., ['rock', 'pop', 'jazz']).\n",
        "        sr (int): The sample rate used during training.\n",
        "        duration (int): The clip duration used during training.\n",
        "        device (str): The device for inference ('cuda' or 'cpu').\n",
        "    \"\"\"\n",
        "    model.eval()\n",
        "\n",
        "    # 1. Prompt user to upload the file\n",
        "    print(\"Please upload the WAV/MP3 audio file you want to classify.\")\n",
        "    try:\n",
        "        uploaded = files.upload()\n",
        "    except Exception as e:\n",
        "        print(f\"File upload error: {e}\")\n",
        "        return\n",
        "\n",
        "    # 2. Read the uploaded file (assuming only one is uploaded)\n",
        "    if not uploaded:\n",
        "        print(\"No file was uploaded.\")\n",
        "        return\n",
        "\n",
        "    # Get the file name and the bytes of the uploaded file\n",
        "    file_name = next(iter(uploaded))\n",
        "    audio_bytes = uploaded[file_name]\n",
        "\n",
        "    # Use io.BytesIO to treat the bytes as an in-memory file object\n",
        "    audio_file_like = io.BytesIO(audio_bytes)\n",
        "\n",
        "    print(f\"File loaded: {file_name}. Processing...\")\n",
        "\n",
        "    try:\n",
        "        # 3. AUDIO PREPROCESSING (Matching Training Pipeline)\n",
        "\n",
        "        # Load and resample from in-memory object\n",
        "        audio, _ = librosa.load(audio_file_like, sr=sr, mono=True)\n",
        "\n",
        "        # Padding/Trimming to ensure fixed length\n",
        "        num_samples = int(duration * sr)\n",
        "        if len(audio) > num_samples:\n",
        "            # Trim\n",
        "            audio = audio[:num_samples]\n",
        "        elif len(audio) < num_samples:\n",
        "            # Pad with zeros\n",
        "            padding = num_samples - len(audio)\n",
        "            audio = np.pad(audio, (0, padding), 'constant')\n",
        "\n",
        "        # 4. CONVERSION TO TENSOR\n",
        "        # Required shape for CNN 1D: [Batch Size, Channels, Samples] -> [1, 1, M]\n",
        "        audio_tensor = torch.tensor(audio, dtype=torch.float32).unsqueeze(0).unsqueeze(0).to(device)\n",
        "\n",
        "        # 5. INFERENCE\n",
        "        with torch.no_grad():\n",
        "            output = model(audio_tensor)\n",
        "\n",
        "        # 6. OUTPUT PROCESSING\n",
        "        probabilities = F.softmax(output, dim=1)\n",
        "        predicted_index = torch.argmax(probabilities, dim=1).item()\n",
        "\n",
        "        # 7. RESULT\n",
        "        predicted_genre = class_names[predicted_index]\n",
        "        confidence = probabilities[0, predicted_index].item()\n",
        "\n",
        "        print(\"\\n\" + \"=\"*60)\n",
        "        print(f\"GENRE PREDICTION for {file_name}:\")\n",
        "        print(f\"Predicted Genre: {predicted_genre.upper()}\")\n",
        "        print(f\"Confidence: {confidence:.2%}\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Error during processing or inference: {e}\")\n",
        "        return"
      ],
